{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federal Spending Radar Award Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "award_id",
    "generated_award_id",
    "award_type",
    "description",
    "recipient_name",
    "awarding_agency",
    "awarding_subagency",
    "awarding_office",
    "funding_agency",
    "funding_subagency",
    "funding_office",
    "obligated_amount",
    "period_start",
    "current_period_end",
    "source_url",
    "source_api_url",
    "retrieved_at"
  ],
  "properties": {
    "award_id": {"type": "string", "minLength": 1},
    "generated_award_id": {"type": "string", "minLength": 1},
    "award_type": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "recipient_name": {"type": "string", "minLength": 1},
    "recipient_uei": {"type": ["string", "null"]},
    "awarding_agency": {"type": "string", "minLength": 1},
    "awarding_subagency": {"type": ["string", "null"]},
    "awarding_office": {"type": "string", "minLength": 1},
    "funding_agency": {"type": ["string", "null"]},
    "funding_subagency": {"type": ["string", "null"]},
    "funding_office": {"type": ["string", "null"]},
    "obligated_amount": {"type": ["number", "null"]},
    "current_and_exercised_options": {"type": ["number", "null"]},
    "potential_total_value": {"type": ["number", "null"]},
    "date_signed": {"type": ["string", "null"], "format": "date"},
    "period_start": {"type": "string", "format": "date"},
    "current_period_end": {"type": "string", "format": "date"},
    "potential_period_end": {"type": ["string", "null"], "format": "date"},
    "record_last_modified": {"type": ["string", "null"], "format": "date"},
    "parent_award_id": {"type": ["string", "null"]},
    "parent_generated_award_id": {"type": ["string", "null"]},
    "parent_vehicle_type": {"type": ["string", "null"]},
    "parent_vehicle_award_structure": {"type": ["string", "null"]},
    "naics_code": {"type": ["string", "null"]},
    "naics_description": {"type": ["string", "null"]},
    "psc_code": {"type": ["string", "null"]},
    "psc_description": {"type": ["string", "null"]},
    "set_aside": {"type": ["string", "null"]},
    "competition": {"type": ["string", "null"]},
    "offers_received": {"type": ["string", "null"]},
    "pricing_type": {"type": ["string", "null"]},
    "place_of_performance_state": {"type": ["string", "null"]},
    "place_of_performance_city": {"type": ["string", "null"]},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.usaspending\\.gov/award/"},
    "source_api_url": {"type": "string", "format": "uri", "pattern": "^https://api\\.usaspending\\.gov/api/v2/awards/"},
    "retrieved_at": {"type": "string", "format": "date-time"}
  }
}
